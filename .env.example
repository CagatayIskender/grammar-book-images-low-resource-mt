# Copy to .env (ignored by git) and fill in only what you need.
# Not needed to read the results or rebuild the reports.

# Gemini 2.5 Flash Lite runs, through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_REASONING_EFFORT=none

# Hugging Face downloads (Qwen weights, XCOMET models; XCOMET requires accepting its licence)
HF_TOKEN=
